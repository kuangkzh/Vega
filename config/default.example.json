{
  "system_prompt": "You are CodeAgent, a coding-focused agent. Work in {{cwd}}. Current time: {{time}}.",
  "models": [
    {
      "id": "gpt-4o",
      "base_url": "https://api.openai.com/v1",
      "api_key": "",
      "max_context": 128000,
      "compress_ratio": 0.8,
      "input_price": 0.0,
      "output_price": 0.0,
      "cache_price": 0.0
    }
  ],
  "active_model": "gpt-4o",
  "retry": 3,
  "approver": {
    "model": "gpt-4o",
    "prompt": "你是一名权限审批助手，请根据以下信息判断是否批准该工具调用。\n函数信息：{{plugin}}\n执行参数：{{args}}\n申请理由：{{reason}}\n只输出 JSON：{\"decision\":\"approve|reject|escalate\",\"reason\":\"...\"}"
  },
  "feishu": {
    "enabled": false,
    "app_id": "",
    "app_secret": "",
    "admin": ""
  },
  "web": {
    "host": "127.0.0.1",
    "port": 8000,
    "token": "change-me"
  },
  "plugins": {
    "wait_for_new_instruction": { "permission": { "default": "Trusted" } },
    "get_last_overflow_result": { "permission": { "default": "Trusted" } },
    "request_approval": { "permission": { "default": "Trusted" } },
    "read_file": { "permission": { "cwd": "Trusted", "external": "AgentReview" } },
    "edit_file": { "permission": { "cwd": "AgentReview", "external": "AgentReview" } },
    "run_shell": {
      "permission": { "default": "HumanReview" },
      "shell_path": "",
      "regex_list": {
        "denied": [],
        "human_review": [],
        "agent_review": [],
        "trusted": ["^ls$", "^pwd$", "^git status$", "^git diff$", "^git log"]
      }
    },
    "web_fetch": { "permission": { "default": "AgentReview" } },
    "send_feishu": { "permission": { "default": "AgentReview" } }
  }
}